ANTHROPIC_API_KEY=
TAVILY_API_KEY=
# Optional: pick the Claude models (these are the defaults)
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_FAST_MODEL=claude-haiku-5-5

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=

# OAuth client of type "Web application" downloaded from Google Cloud
GOOGLE_CLIENT_SECRETS=credentials.json
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
FRONTEND_URL=http://localhost:5173

OAUTHLIB_INSECURE_TRANSPORT=1   # local http only. Remove in production
CORS_ORIGINS=http://localhost:5173  # where the frontend is served from
MAX_RUNS_PER_DAY=50

# Autopilot: how often (minutes) the background agent looks after each student's calendar. 0 turns it off.
AGENT_INTERVAL_MIN=5
# How often (hours) it searches again for new programmes on its own. 0 turns that off.
AUTO_DISCOVERY_HOURS=2
# How often (hours) it looks at programmes that have not opened yet.
WATCH_EVERY_HOURS=1
# Minutes after a student runs a search before it looks again at new and watched programmes. 0 = off.
SEARCH_FOLLOW_UP_MIN=2

# The planner: a Claude agent that reads the student's whole situation and decides what to do. 0 = use the fixed rules only.
PLANNER=1
# Most planner passes per student per day (a pass only happens when something changed)
PLANNER_MAX_PER_DAY=12
